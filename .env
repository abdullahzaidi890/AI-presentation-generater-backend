# Copy this file to .env and fill ONLY the providers you want to use.
# Keys stay on the backend. Never put them in the frontend.
GROQ_API_KEY=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
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional extra provider (xAI Grok). Only used if the key is set.
XAI_API_KEY=
XAI_MODEL=grok-4

# Fallback order if the chosen provider fails (comma separated). Mock is never used as a silent fallback.
FALLBACK_ORDER=groq,gemini,claude
ENABLE_FALLBACK=true

REQUEST_TIMEOUT_SECONDS=30
MAX_UPLOAD_MB=10
FRONTEND_ORIGIN=http://localhost:5173
